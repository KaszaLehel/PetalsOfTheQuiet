  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "L\xE9pj. W, A, S, D \u2013 ezek a bet\u0171k most a l\xE1baid.\n\nL\xE1tsz
    valamit, ami kiemelkedik a n\xE9mas\xE1gb\xF3l? Egy k\xFCl\xF6n\xF6s t\xE1rgy,
    egy sz\xEDnes vir\xE1g, valami, ami \u201E\xE9rezhet\u0151\u201D a cs\xF6ndben?
    N\xE9zz r\xE1, \xE9s nyomd meg az E-t. Tal\xE1n csak egy eml\xE9k... tal\xE1n
    maga a hang rejt\u0151zik benne.\n\nVannak dolgok, amiket nem csak l\xE1tni kell.
    Meg kell fognod \u0151ket. A bal eg\xE9rgomb a kezed: nyomd le, \xE9s a t\xE1rgy
    engedelmesen k\xF6vet, am\xEDg el nem engeded. Tal\xE1n egy hang is utazik vele.\n\nHa
    m\xE1s szemsz\xF6gb\u0151l jobban \xE9rted a vil\xE1got, nyomd meg az Alpha-1
    gombot. A kamera v\xE1lt, a n\xE9ma t\xF6rt\xE9net m\xE1s szemmel mes\xE9l.\nEbben
    a n\xE9zetben is mozoghatsz a W, A, S, D gombokkal, \xE9s a vil\xE1got forgathatod
    Q \xE9s E seg\xEDts\xE9g\xE9vel. G\xF6rg\u0151vel k\xF6zel\xEDteni lehet. N\xE9ha
    a csendet m\xE1s sz\xF6gb\u0151l kell n\xE9zni, hogy meg\xE9rtsd."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 644169771669f7948b4fff9deecb95e2, type: 2}
  m_sharedMaterial: {fileID: -2606568697636236444, guid: 644169771669f7948b4fff9deecb95e2, type: 2}
